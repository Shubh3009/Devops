## **6. Looping Constructs**

### **for loops**
```bash
#!/bin/bash
# Example 1: Basic for loop
echo "Counting 1 to 5:"
for i in 1 2 3 4 5; do
    echo "Number: $i"
done

# Example 2: Range
for i in {1..5}; do
    echo "Count: $i"
done

# Example 3: C-style for loop
for ((i=1; i<=5; i++)); do
    echo "Iteration: $i"
done

# Example 4: Iterating over array
colors=("red" "green" "blue")
for color in "${colors[@]}"; do
    echo "Color: $color"
done

# Example 5: Iterating over command output
for file in $(ls *.sh); do
    echo "Script: $file"
done
```

### **while loops**
```bash
#!/bin/bash
# Example 1: Counter
count=1
while [ $count -le 5 ]; do
    echo "While loop: $count"
    count=$((count + 1))
done

# Example 2: Reading file line by line
while IFS= read -r line; do
    echo "Line: $line"
done < "file.txt"

# Example 3: Infinite loop with break
while true; do
    read -p "Enter 'quit' to exit: " input
    if [ "$input" == "quit" ]; then
        break
    fi
    echo "You entered: $input"
done
```

### **until loops**
```bash
#!/bin/bash
# Example 1: Runs until condition becomes true
count=1
until [ $count -gt 5 ]; do
    echo "Until loop: $count"
    count=$((count + 1))
done

# Example 2: Waiting for file to exist
file="data.txt"
until [ -f "$file" ]; do
    echo "Waiting for $file..."
    sleep 2
done
echo "$file found!"
```

