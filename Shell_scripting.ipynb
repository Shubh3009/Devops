## **7. Functions in Shell Scripts**

### **Definition**
Functions allow you to group commands for reuse and better code organization.

### **Example 1: Basic function**
```bash
#!/bin/bash
# Define function
greet() {
    echo "Hello, $1!"
    local message="Welcome to shell scripting"
    echo "$message"
}

# Call function
greet "Alice"
greet "Bob"

# Local variable demo
echo "Message outside: $message"  # Will be empty
```

### **Example 2: Function with return value**
```bash
#!/bin/bash
# Function that returns exit code
is_even() {
    local num=$1
    if (( num % 2 == 0 )); then
        return 0  # Success/true
    else
        return 1  # Failure/false
    fi
}

# Function that "returns" a value using echo
add() {
    local result=$(( $1 + $2 ))
    echo $result
}

# Using the functions
is_even 10
echo "Is 10 even? Exit code: $?"

sum=$(add 5 3)
echo "5 + 3 = $sum"
```

### **Example 3: Advanced function usage**
```bash
#!/bin/bash
# Function with default parameters
create_user() {
    local username=${1:-"guest"}  # Default to "guest"
    local shell=${2:-"/bin/bash"} # Default shell
    
    echo "Creating user: $username"
    echo "Shell: $shell"
    # Simulated user creation
    echo "User $username created successfully"
}

# Function that processes arguments
process_args() {
    echo "Number of arguments: $#"
    echo "All arguments: $@"
    
    for arg in "$@"; do
        echo "Processing: $arg"
    done
}

# Call functions
create_user "alice"
create_user  # Uses defaults
process_args arg1 arg2 arg3
```

