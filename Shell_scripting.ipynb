## **📊 Quick Reference Cheat Sheet**

```bash
# Shebang
#!/bin/bash

# Variables
name="value"
echo "$name"
readonly constant="can't change"

# Arrays
arr=(item1 item2)
echo "${arr[0]}"

# Conditionals
if [ condition ]; then
    commands
elif [ condition ]; then
    commands
else
    commands
fi

# Loops
for item in list; do
    commands
done

while [ condition ]; do
    commands
done

# Functions
func_name() {
    commands
    return value
}

# Exit codes
exit 0  # Success
exit 1  # Failure
echo $? # Check last exit code
```

