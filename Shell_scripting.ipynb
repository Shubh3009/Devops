## **📝 Practice Script: Complete Example**
```bash
#!/bin/bash
# backup_script.sh - A complete example

# Function definitions
show_help() {
    echo "Usage: $0 [OPTION] SOURCE DEST"
    echo "Backup files from SOURCE to DEST"
    echo ""
    echo "Options:"
    echo "  -v    Verbose output"
    echo "  -h    Show this help"
    exit 0
}

backup_files() {
    local src=$1
    local dest=$2
    local verbose=$3
    
    if [ ! -d "$src" ]; then
        echo "Error: Source directory doesn't exist" >&2
        return 1
    fi
    
    [ "$verbose" = true ] && echo "Starting backup..."
    
    # Create backup directory with timestamp
    local backup_dir="${dest}/backup_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$backup_dir"
    
    # Copy files
    cp -r "$src"/* "$backup_dir" 2>/dev/null
    
    if [ $? -eq 0 ]; then
        [ "$verbose" = true ] && echo "Backup completed: $backup_dir"
        return 0
    else
        echo "Error: Backup failed" >&2
        return 1
    fi
}

# Main script
verbose=false

# Parse options
while getopts "vh" opt; do
    case $opt in
        v) verbose=true ;;
        h) show_help ;;
        *) echo "Invalid option"; exit 1 ;;
    esac
done

shift $((OPTIND-1))

# Check arguments
if [ $# -lt 2 ]; then
    echo "Error: Source and destination required" >&2
    echo "Use -h for help"
    exit 1
fi

source_dir=$1
dest_dir=$2

# Execute backup
backup_files "$source_dir" "$dest_dir" "$verbose"
exit_code=$?

exit $exit_code
```

